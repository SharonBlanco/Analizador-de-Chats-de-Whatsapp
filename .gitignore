# Entorno virtual de Python
.venv/
__pycache__/
*.pyc

# Datos que genera el sistema al usarse (cada uno tiene los suyos)
uploads/
results/
worker/workspace/
workspace/
# Carpetas del I Proyecto que siguen en esta carpeta. La "/" inicial limita la regla a la raíz:
# sin ella, "worker/" también ignoraba distribuido/worker/ (el worker nuevo).
/pruebas/
/scripts/
/worker/

# Dataset generado (se recrea con scripts/generar_dataset.py) y salidas de pruebas
dataset_prueba/
dataset_real/
resultados_descargados/

# Editor / sistema
.vscode/
.idea/
.DS_Store

# Chats importados y exportaciones del teléfono: datos sensibles, nunca al repositorio
dataset_whatsapp/
exportados/

# Archivos de bloqueo de LibreOffice / Office
.~lock.*
~$*

# Credenciales del procesamiento distribuido
distribuido/config.env

# Dataset: fuentes descargadas y dataset generado (se recrean con generador_dataset/)
fuentes_dataset/
dataset_generado/

# Pesos de modelos descargados (YOLO)
*.pt
docs/mediciones/m1/**/.trabajos/

# M4: certificados y claves privadas locales
distribuido/certs/

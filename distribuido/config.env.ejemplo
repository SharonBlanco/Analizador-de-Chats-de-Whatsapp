# Copie este archivo como distribuido/config.env y complete los valores.
# config.env está excluido de Git: las credenciales nunca van en el código.

# RabbitMQ (en la PC del coordinador). Si ya usa el RabbitMQ del I Proyecto, ponga sus credenciales.
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=
RABBIT_PASS=
# O bien RabbitMQ en la nube (CloudAMQP, plan gratuito): pegue su URL "amqps://…". Si está, reemplaza
# a RABBIT_HOST/PORT/USER/PASS y la conexión va cifrada con TLS.
# RABBIT_URL=amqps://usuario:clave@servidor.rmq.cloudamqp.com/usuario

# Token compartido entre coordinador y workers para descargar adjuntos.
# Genérelo con:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WORKER_TOKEN=

# --- Solo en los workers ---
# Dirección del coordinador para descargar adjuntos (puerto de workers, 8101 por defecto)
COORDINADOR_URL=http://localhost:8101
# WORKER_ID=worker-1
# WORKER_POOLS=texto,adjuntos
# WORKER_CONCURRENCIA=1

# Workers de otras redes (Colab, Azure…): el coordinador les manda en cada tarea la dirección actual del
# túnel de Cloudflare (la detecta solo). Para fijar otra dirección: WA_URL_PUBLICA=https://…
# El worker de la PC del coordinador descarga directo por localhost:
# WA_PREFERIR_LOCAL=1
